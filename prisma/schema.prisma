generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model appointment {
  id             Int           @id @default(autoincrement())
  date           DateTime
  duration       Int           @default(30)
  status         String        @default("pending")
  serviceType    String?
  notes          String?
  clientId       Int
  petId          Int
  organizationId Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  client         client        @relation(fields: [clientId], references: [id], map: "Appointment_clientId_fkey")
  organization   organization  @relation(fields: [organizationId], references: [id], map: "Appointment_organizationId_fkey")
  pet            pet           @relation(fields: [petId], references: [id], map: "Appointment_petId_fkey")
  consultation   consultation?

  @@index([clientId], map: "Appointment_clientId_fkey")
  @@index([petId], map: "Appointment_petId_fkey")
  @@index([organizationId], map: "Appointment_organizationId_fkey")
}

model attachment {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  fileUrl    String
  createdAt  DateTime @default(now())
}

model client {
  id             Int              @id @default(autoincrement())
  name           String
  documentId     String?          @unique(map: "Client_documentId_key")
  phone          String?
  phone2         String?
  email          String?
  address        String?
  birthDate      DateTime?
  notes          String?
  isActive       Boolean          @default(true)
  organizationId Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  appointment    appointment[]
  organization   organization     @relation(fields: [organizationId], references: [id], map: "Client_organizationId_fkey")
  consultation   consultation[]
  fiscaldocument fiscaldocument[]
  pet            pet[]
  sale           sale[]

  @@index([organizationId], map: "Client_organizationId_fkey")
}

model clinics {
  id             Int          @id @default(autoincrement())
  name           String
  address        String?
  phone          String?
  email          String?
  timezone       String       @default("America/Montevideo")
  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organization   organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model consultation {
  id              Int              @id @default(autoincrement())
  petId           Int
  clientId        Int
  appointmentId   Int?             @unique(map: "Consultation_appointmentId_key")
  organizationId  Int
  weight          Float?
  temperature     Float?
  symptoms        String?
  diagnosis       String?
  treatment       String?
  notes           String?
  consultationFee Float            @default(0)
  treatmentFee    Float            @default(0)
  totalFee        Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  appointment     appointment?     @relation(fields: [appointmentId], references: [id], map: "Consultation_appointmentId_fkey")
  client          client           @relation(fields: [clientId], references: [id], map: "Consultation_clientId_fkey")
  organization    organization     @relation(fields: [organizationId], references: [id], map: "Consultation_organizationId_fkey")
  pet             pet              @relation(fields: [petId], references: [id], map: "Consultation_petId_fkey")
  diagnoses       diagnosis[]
  fiscaldocuments  fiscaldocument[]
  prescriptions    prescription[]
  sales            sale[]
  treatments       treatment[]

  @@index([clientId], map: "Consultation_clientId_fkey")
  @@index([petId], map: "Consultation_petId_fkey")
  @@index([organizationId], map: "Consultation_organizationId_fkey")
}

model diagnosis {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   consultation @relation(fields: [consultationId], references: [id], map: "Diagnosis_consultationId_fkey")

  @@index([consultationId], map: "Diagnosis_consultationId_fkey")
}

model fiscaldocument {
  id             String                @id
  type           fiscaldocument_type
  series         String?
  number         Int?
  issuedAt       DateTime              @default(now())
  clientId       Int
  consultationId Int?
  subtotal       Decimal
  tax            Decimal
  total          Decimal
  currency       String                @default("UYU")
  cae            String?
  caeExpiration  DateTime?
  cfeXml         String?
  cfePdfUrl      String?
  status         fiscaldocument_status @default(PENDING)
  createdAt      DateTime              @default(now())
  client         client                @relation(fields: [clientId], references: [id], map: "FiscalDocument_clientId_fkey")
  consultation   consultation?         @relation(fields: [consultationId], references: [id], map: "FiscalDocument_consultationId_fkey")
  fiscalitem     fiscalitem[]
  payment        payment[]

  @@index([clientId], map: "FiscalDocument_clientId_fkey")
  @@index([consultationId], map: "FiscalDocument_consultationId_fkey")
}

model fiscalitem {
  id               String         @id
  fiscalDocumentId String
  description      String
  quantity         Decimal
  unitPrice        Decimal
  taxRate          Decimal
  total            Decimal
  fiscaldocument   fiscaldocument @relation(fields: [fiscalDocumentId], references: [id], map: "FiscalItem_fiscalDocumentId_fkey")

  @@index([fiscalDocumentId], map: "FiscalItem_fiscalDocumentId_fkey")
}

model idempotencykey {
  id         Int      @id @default(autoincrement())
  key        String
  endpoint   String
  response   Json?
  statusCode Int?
  createdAt  DateTime @default(now())

  @@unique([key, endpoint], map: "IdempotencyKey_key_endpoint_key")
}

model organization {
  id             Int              @id @default(autoincrement())
  name           String
  address        String?
  phone          String?
  email          String?
  taxId          String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  appointment    appointment[]
  client         client[]
  clinics        clinics[]
  consultation   consultation[]
  pet            pet[]
  products       products[]
  refresh_tokens refresh_tokens[]
  sale           sale[]
  services       services[]
  users          users[]
}

model payment {
  id               String         @id
  fiscalDocumentId String
  amount           Decimal
  method           payment_method
  reference        String?
  notes            String?
  paidAt           DateTime       @default(now())
  createdAt        DateTime       @default(now())
  fiscaldocument   fiscaldocument @relation(fields: [fiscalDocumentId], references: [id], map: "Payment_fiscalDocumentId_fkey")

  @@index([fiscalDocumentId], map: "Payment_fiscalDocumentId_fkey")
}

model pet {
  id                 Int            @id @default(autoincrement())
  name               String
  species            String
  breed              String?
  birthDate          DateTime?
  weight             Float?
  color              String?
  microchip          String?        @unique(map: "Pet_microchip_key")
  isActive           Boolean        @default(true)
  notes              String?
  clientId           Int
  organizationId     Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  birthDateEstimated Boolean?       @default(false)
  deathDate          DateTime?
  appointment        appointment[]
  consultation       consultation[]
  client             client         @relation(fields: [clientId], references: [id], map: "Pet_clientId_fkey")
  organization       organization   @relation(fields: [organizationId], references: [id], map: "Pet_organizationId_fkey")
  sale               sale[]

  @@index([clientId], map: "Pet_clientId_fkey")
  @@index([organizationId], map: "Pet_organizationId_fkey")
}

model prescription {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   consultation @relation(fields: [consultationId], references: [id], map: "Prescription_consultationId_fkey")

  @@index([consultationId], map: "Prescription_consultationId_fkey")
}

model product_categories {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model products {
  id             Int             @id @default(autoincrement())
  name           String
  description    String?
  category       String?
  price          Float
  cost           Float?
  stock          Int             @default(0)
  minStock       Int             @default(5)
  isActive       Boolean         @default(true)
  organizationId Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  organization   organization    @relation(fields: [organizationId], references: [id])
  stockmovement  stockmovement[]

  @@index([organizationId], map: "products_organizationId_fkey")
}

model refresh_tokens {
  id             Int          @id @default(autoincrement())
  token          String       @db.Text
  user_id        Int
  expires_at     DateTime
  created_at     DateTime     @default(now())
  role           String
  organizationId Int
  organization   organization @relation(fields: [organizationId], references: [id])
  users          users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "refresh_tokens_user_id_fkey")
  @@index([organizationId], map: "refresh_tokens_organizationId_fkey")
}

model sale {
  id             Int           @id @default(autoincrement())
  clientId       Int
  petId          Int?
  consultationId Int?
  organizationId Int
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  tax            Float         @default(0)
  total          Float         @default(0)
  status         String        @default("completed")
  paymentMethod  String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  client         client        @relation(fields: [clientId], references: [id], map: "Sale_clientId_fkey")
  consultation   consultation? @relation(fields: [consultationId], references: [id], map: "Sale_consultationId_fkey")
  organization   organization  @relation(fields: [organizationId], references: [id], map: "Sale_organizationId_fkey")
  pet            pet?          @relation(fields: [petId], references: [id], map: "Sale_petId_fkey")
  saleitem       saleitem[]

  @@index([clientId], map: "Sale_clientId_fkey")
  @@index([consultationId], map: "Sale_consultationId_fkey")
  @@index([petId], map: "Sale_petId_fkey")
  @@index([organizationId], map: "Sale_organizationId_fkey")
}

model saleitem {
  id            Int    @id @default(autoincrement())
  saleId        Int
  itemType      String
  itemId        Int
  nameSnapshot  String
  priceSnapshot Float
  quantity      Int
  subtotal      Float
  sale          sale   @relation(fields: [saleId], references: [id], map: "SaleItem_saleId_fkey")

  @@index([saleId], map: "SaleItem_saleId_fkey")
}

model services {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  price          Float
  duration       Int?
  category       String?
  isActive       Boolean      @default(true)
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organization   organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId], map: "services_organizationId_fkey")
}

model stockmovement {
  id            Int      @id @default(autoincrement())
  productId     Int
  type          String
  quantity      Int
  reason        String?
  referenceType String?
  referenceId   Int?
  notes         String?
  createdAt     DateTime @default(now())
  products      products @relation(fields: [productId], references: [id], map: "StockMovement_productId_fkey")

  @@index([productId], map: "StockMovement_productId_fkey")
}

model treatment {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   consultation @relation(fields: [consultationId], references: [id], map: "Treatment_consultationId_fkey")

  @@index([consultationId], map: "Treatment_consultationId_fkey")
}

model users {
  id             Int              @id @default(autoincrement())
  username       String           @unique @db.VarChar(50)
  email          String           @unique @db.VarChar(100)
  password       String           @db.VarChar(255)
  role           String           @default("user")
  isActive       Boolean          @default(true)
  lastLogin      DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime
  organizationId Int
  refresh_tokens refresh_tokens[]
  organization   organization     @relation(fields: [organizationId], references: [id])

  @@index([organizationId], map: "users_organizationId_fkey")
}

enum fiscaldocument_type {
  E_TICKET
  E_FACTURA
  E_TICKET_NOTA_CREDITO
}

enum payment_method {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  MERCADO_PAGO
  ACCOUNT_CREDIT
}

enum fiscaldocument_status {
  PENDING
  ACCEPTED
  REJECTED
}

