generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id                   Int                  @id @default(autoincrement())
  name                 String
  rut                  String?              @unique
  website              String?
  imageUrl             String?
  imagePublicId        String?
  imageVersion         String?
  address              String?
  phone                String?
  email                String?
  isDefault            Boolean              @default(false)
  organizationId       Int
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  isActive             Boolean              @default(true)
  timezone             String?              @default("America/Montevideo")
  appointments         Appointment[]
  attachments          Attachment[]
  clients              Client[]
  clientSubscriptions  ClientSubscription[]
  organization         Organization         @relation(fields: [organizationId], references: [id])
  consultations        Consultation[]
  medicalPlans         MedicalPlan[]
  products             Product[]
  productSubcategories ProductSubcategory[]
  stockMovements       StockMovement[]
  refreshTokens        RefreshToken[]
  sales                Sale[]
  services             Service[]
  users                User[]               @relation("UserClinics")

  cashRegisters   CashRegister[]
  cashShifts      CashShift[]
  cashMovements   CashMovement[]
  ticketPrints    TicketPrint[]
  cashAuditEvents CashAuditEvent[]

  subscriptionInstallments SubscriptionInstallment[]

  consultorios Consultorio[]
  equipment    Equipment[]

  @@index([organizationId], map: "clinics_organizationId_fkey")
  @@map("clinics")
}

model User {
  id                Int             @id @default(autoincrement())
  username          String          @unique @db.VarChar(50)
  email             String          @unique @db.VarChar(100)
  password          String          @db.VarChar(255)
  role              String          @default("USER")
  isActive          Boolean         @default(true)
  lastLogin         DateTime?
  passwordChangedAt DateTime?       @db.DateTime(0)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  organizationId    Int
  refreshTokens     RefreshToken[]
  organization      Organization    @relation(fields: [organizationId], references: [id])
  subscriptions     Subscription[]  @relation("SubscriptionUsers")
  clinics           Clinic[]        @relation("UserClinics")
  stockMovements    StockMovement[]

  cashShifts      CashShift[]
  cashMovements   CashMovement[]
  sales           Sale[]
  ticketPrints    TicketPrint[]
  cashAuditEvents CashAuditEvent[]

  @@index([organizationId], map: "users_organizationId_fkey")
  @@map("users")
}

model RefreshToken {
  id             Int          @id @default(autoincrement())
  token          String       @db.Text
  userId         Int          @map("user_id")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  role           String
  clinicId       Int?         @map("clinic_id")
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId], map: "refresh_tokens_clinic_id_fkey")
  @@index([userId], map: "refresh_tokens_user_id_fkey")
  @@index([organizationId], map: "refresh_tokens_organizationId_fkey")
  @@map("refresh_tokens")
}

model Product {
  id             Int                 @id @default(autoincrement())
  name           String
  description    String?
  sku            String?             @unique
  barcode        String?
  brand          String?
  supplier       String?
  categoryId     Int?                @map("category_id")
  subcategoryId  Int?                @map("subcategory_id")
  priceType      ProductPriceType    @default(FIXED)
  price          Float
  ivaIncluded    Boolean             @default(true)
  cost           Float?
  stock          Int                 @default(0)
  minStock       Int                 @default(5)
  maxStock       Int?
  isActive       Boolean             @default(true)
  discontinuedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  clinicId       Int
  category       ProductCategory?    @relation(fields: [categoryId], references: [id])
  subcategory    ProductSubcategory? @relation(fields: [subcategoryId], references: [id])
  clinic         Clinic              @relation(fields: [clinicId], references: [id])
  stockMovements StockMovement[]

  @@index([categoryId], map: "products_category_id_fkey")
  @@index([subcategoryId], map: "products_subcategory_id_fkey")
  @@index([clinicId], map: "products_clinicId_fkey")
  @@map("products")
}

model ProductCategory {
  id            Int                  @id @default(autoincrement())
  name          String
  description   String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  clinicId      Int                  @default(1)
  products      Product[]
  subcategories ProductSubcategory[]

  @@map("product_categories")
}

model ProductSubcategory {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  clinicId    Int             @default(1)
  categoryId  Int
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  products    Product[]

  @@index([clinicId])
  @@index([categoryId])
  @@map("product_subcategories")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  duration    Int?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinicId    Int
  clinic      Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId], map: "services_clinicId_fkey")
  @@map("services")
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  interval      String
  features      Json
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id             Int          @id @default(autoincrement())
  planId         Int
  organizationId Int
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean      @default(true)
  paymentMethod  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  plan           Plan         @relation(fields: [planId], references: [id])
  users          User[]       @relation("SubscriptionUsers")

  @@index([organizationId], map: "subscriptions_organizationId_fkey")
  @@index([planId], map: "subscriptions_planId_fkey")
  @@map("subscriptions")
}

model Appointment {
  id           Int           @id @default(autoincrement())
  date         DateTime
  duration     Int           @default(30)
  status       String        @default("pending")
  serviceType  String?
  notes        String?
  clientId     Int
  petId        Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  clinicId     Int
  client       Client        @relation(fields: [clientId], references: [id], map: "Appointment_clientId_fkey")
  clinic       Clinic        @relation(fields: [clinicId], references: [id], map: "Appointment_clinicId_fkey")
  pet          Pet           @relation(fields: [petId], references: [id], map: "Appointment_petId_fkey")
  consultation Consultation?

  @@index([clientId], map: "Appointment_clientId_fkey")
  @@index([clinicId], map: "Appointment_clinicId_fkey")
  @@index([petId], map: "Appointment_petId_fkey")
  @@map("appointments")
}

model Attachment {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  fileUrl    String
  createdAt  DateTime @default(now())
  clinicId   Int
  clinic     Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId], map: "attachment_clinicId_fkey")
  @@map("attachments")
}

model Client {
  id                  Int                  @id @default(autoincrement())
  name                String
  documentId          String?              @unique(map: "Client_documentId_key")
  phone               String?
  phone2              String?
  email               String?
  address             String?
  birthDate           DateTime?
  notes               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  clinicId            Int
  appointments        Appointment[]
  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  clientSubscriptions ClientSubscription[]
  consultations       Consultation[]
  fiscalDocuments     FiscalDocument[]
  pets                Pet[]
  sales               Sale[]

  @@index([clinicId], map: "Client_clinicId_fkey")
  @@map("clients")
}

model ClientSubscription {
  id               Int                       @id @default(autoincrement())
  medicalPlanId    Int
  clientId         Int
  clinicId         Int
  contractedPrice  Decimal                   @db.Decimal(12, 2)
  periodicity      MedicalPlanPeriodicity
  startDate        DateTime                  @default(now())
  endDate          DateTime?
  nextDueDate      DateTime?
  status           ClientSubscriptionStatus  @default(ACTIVE)
  suspensionReason String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  client           Client                    @relation(fields: [clientId], references: [id])
  clinic           Clinic                    @relation(fields: [clinicId], references: [id])
  medicalPlan      MedicalPlan               @relation(fields: [medicalPlanId], references: [id])
  pets             ClientSubscriptionPet[]
  installments     SubscriptionInstallment[]

  @@index([clientId])
  @@index([clinicId, clientId])
  @@index([clinicId, status])
  @@index([medicalPlanId])
  @@index([nextDueDate])
  @@map("client_subscriptions")
}

model ClientSubscriptionPet {
  subscriptionId Int
  petId          Int
  createdAt      DateTime           @default(now())
  subscription   ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  pet            Pet                @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@id([subscriptionId, petId])
  @@index([petId])
  @@map("client_subscription_pets")
}

model SubscriptionInstallment {
  id             Int                           @id @default(autoincrement())
  subscriptionId Int
  clinicId       Int
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  amount         Decimal                       @db.Decimal(12, 2)
  lateFee        Decimal                       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal                       @db.Decimal(12, 2)
  status         SubscriptionInstallmentStatus @default(PENDING)
  paidAt         DateTime?
  saleId         Int?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  subscription   ClientSubscription            @relation(fields: [subscriptionId], references: [id])
  clinic         Clinic                        @relation(fields: [clinicId], references: [id])
  sale           Sale?                         @relation(fields: [saleId], references: [id])

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([clinicId, status, dueDate])
  @@index([subscriptionId, dueDate])
  @@index([saleId])
  @@index([paidAt])
  @@map("subscription_installments")
}

model Consultation {
  id              Int              @id @default(autoincrement())
  petId           Int
  clientId        Int
  appointmentId   Int?             @unique(map: "Consultation_appointmentId_key")
  weight          Float?
  temperature     Float?
  symptoms        String?
  notes           String?
  consultationFee Float            @default(0)
  treatmentFee    Float            @default(0)
  totalFee        Float            @default(0)
  status          String           @default("OPEN")
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clinicId        Int
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id], map: "Consultation_appointmentId_fkey")
  client          Client           @relation(fields: [clientId], references: [id], map: "Consultation_clientId_fkey")
  clinic          Clinic           @relation(fields: [clinicId], references: [id], map: "Consultation_clinicId_fkey")
  pet             Pet              @relation(fields: [petId], references: [id], map: "Consultation_petId_fkey")
  diagnoses       Diagnosis[]
  fiscalDocuments FiscalDocument[]
  prescriptions   Prescription[]
  sales           Sale[]
  treatments      Treatment[]

  consultorioId Int?
  startAt       DateTime?
  endAt         DateTime?

  consultorio Consultorio? @relation(fields: [consultorioId], references: [id])

  priority PriorityConsultation @default(NORMAL)

  @@index([consultorioId])
  @@index([consultorioId, startAt, endAt])
  @@index([clientId], map: "Consultation_clientId_fkey")
  @@index([clinicId], map: "Consultation_clinicId_fkey")
  @@index([petId], map: "Consultation_petId_fkey")
  @@map("consultations")
}

model Diagnosis {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   Consultation @relation(fields: [consultationId], references: [id], map: "Diagnosis_consultationId_fkey")

  @@index([consultationId], map: "Diagnosis_consultationId_fkey")
  @@map("diagnoses")
}

model FiscalDocument {
  id             String               @id
  type           FiscalDocumentType
  series         String?
  number         Int?
  issuedAt       DateTime             @default(now())
  clientId       Int
  consultationId Int?
  subtotal       Decimal
  tax            Decimal
  total          Decimal
  currency       String               @default("UYU")
  cae            String?
  caeExpiration  DateTime?
  cfeXml         String?
  cfePdfUrl      String?
  status         FiscalDocumentStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  client         Client               @relation(fields: [clientId], references: [id], map: "FiscalDocument_clientId_fkey")
  consultation   Consultation?        @relation(fields: [consultationId], references: [id], map: "FiscalDocument_consultationId_fkey")
  fiscalItems    FiscalItem[]
  payments       Payment[]

  saleId Int? @unique

  sale Sale? @relation(fields: [saleId], references: [id])

  @@index([clientId], map: "FiscalDocument_clientId_fkey")
  @@index([consultationId], map: "FiscalDocument_consultationId_fkey")
  @@map("fiscal_documents")
}

model FiscalItem {
  id               String         @id
  fiscalDocumentId String
  description      String
  quantity         Decimal
  unitPrice        Decimal
  taxRate          Decimal
  total            Decimal
  fiscalDocument   FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], map: "FiscalItem_fiscalDocumentId_fkey")

  @@index([fiscalDocumentId], map: "FiscalItem_fiscalDocumentId_fkey")
  @@map("fiscal_items")
}

model IdempotencyKey {
  id         Int      @id @default(autoincrement())
  key        String
  endpoint   String
  response   Json?
  statusCode Int?
  createdAt  DateTime @default(now())

  @@unique([key, endpoint], map: "IdempotencyKey_key_endpoint_key")
  @@map("idempotency_keys")
}

model MedicalPlan {
  id                  Int                    @id @default(autoincrement())
  name                String
  description         String?
  price               Decimal                @db.Decimal(12, 2)
  benefits            Json
  periodicity         MedicalPlanPeriodicity @default(MONTHLY)
  maxPets             Int                    @default(1)
  status              MedicalPlanStatus      @default(ACTIVE)
  applyLateFee        Boolean                @default(false)
  lateFeeType         LateFeeType            @default(NONE)
  lateFeeValue        Decimal                @default(0) @db.Decimal(12, 2)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  clinicId            Int
  clientSubscriptions ClientSubscription[]
  clinic              Clinic                 @relation(fields: [clinicId], references: [id])

  @@index([clinicId, status])
  @@map("medical_plans")
}

model Organization {
  id            Int            @id @default(autoincrement())
  name          String
  address       String?
  phone         String?
  email         String?
  taxId         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  timezone      String?        @default("UTC")
  clinics       Clinic[]
  subscriptions Subscription[]
  users         User[]
  refreshTokens RefreshToken[]

  @@map("organizations")
}

model Payment {
  id               String  @id
  fiscalDocumentId String?
  cashShiftId      Int?
  saleId           Int?

  amount    Decimal
  method    PaymentMethod
  reference String?
  notes     String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  fiscalDocument FiscalDocument? @relation(fields: [fiscalDocumentId], references: [id], map: "Payment_fiscalDocumentId_fkey")
  cashShift      CashShift?      @relation(fields: [cashShiftId], references: [id])
  sale           Sale?           @relation(fields: [saleId], references: [id])

  @@index([fiscalDocumentId], map: "Payment_fiscalDocumentId_fkey")
  @@index([cashShiftId])
  @@index([saleId])
  @@map("payments")
}

model Pet {
  id                 Int                     @id @default(autoincrement())
  name               String
  sex                String?
  species            String
  breed              String?
  birthDate          DateTime?
  weight             Float?
  color              String?
  microchip          String?                 @unique(map: "Pet_microchip_key")
  isActive           Boolean                 @default(true)
  notes              String?
  clientId           Int
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  birthDateEstimated Boolean?                @default(false)
  deathDate          DateTime?
  appointments       Appointment[]
  subscriptionPets   ClientSubscriptionPet[]
  consultations      Consultation[]
  client             Client                  @relation(fields: [clientId], references: [id], map: "Pet_clientId_fkey")
  sales              Sale[]

  @@index([clientId], map: "Pet_clientId_fkey")
  @@map("pets")
}

model Prescription {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   Consultation @relation(fields: [consultationId], references: [id], map: "Prescription_consultationId_fkey")

  @@index([consultationId], map: "Prescription_consultationId_fkey")
  @@map("prescriptions")
}

model Sale {
  id             Int           @id @default(autoincrement())
  clientId       Int
  petId          Int?
  consultationId Int?
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  tax            Float         @default(0)
  total          Float         @default(0)
  status         String        @default("completed")
  paymentMethod  String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  clinicId       Int
  client         Client        @relation(fields: [clientId], references: [id], map: "Sale_clientId_fkey")
  consultation   Consultation? @relation(fields: [consultationId], references: [id], map: "Sale_consultationId_fkey")
  pet            Pet?          @relation(fields: [petId], references: [id], map: "Sale_petId_fkey")
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  saleItems      SaleItem[]

  fiscalDocument FiscalDocument?
  cashShiftId    Int?
  userId         Int?

  cashShift                CashShift?                @relation(fields: [cashShiftId], references: [id])
  user                     User?                     @relation(fields: [userId], references: [id])
  payments                 Payment[]
  ticketPrints             TicketPrint[]
  cashAuditEvents          CashAuditEvent[]
  subscriptionInstallments SubscriptionInstallment[]

  @@index([cashShiftId])
  @@index([userId])
  @@index([clientId], map: "Sale_clientId_fkey")
  @@index([clinicId], map: "Sale_clinicId_fkey")
  @@index([consultationId], map: "Sale_consultationId_fkey")
  @@index([petId], map: "Sale_petId_fkey")
  @@map("sales")
}

model SaleItem {
  id            Int    @id @default(autoincrement())
  saleId        Int
  itemType      String
  itemId        Int
  nameSnapshot  String
  priceSnapshot Float
  unitPrice     Float?
  ivaIncluded   Boolean  @default(false)
  ivaRate       Float    @default(0)
  netAmount     Float    @default(0)
  taxAmount     Float    @default(0)
  quantity      Int
  subtotal      Float
  sale          Sale   @relation(fields: [saleId], references: [id], map: "SaleItem_saleId_fkey")

  @@index([saleId], map: "SaleItem_saleId_fkey")
  @@map("sale_items")
}

model StockMovement {
  id            Int      @id @default(autoincrement())
  productId     Int
  clinicId      Int      @default(1)
  userId        Int?
  type          String
  quantity      Int
  reason        String?
  referenceType String?
  referenceId   Int?
  notes         String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], map: "StockMovement_productId_fkey")
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@index([productId], map: "StockMovement_productId_fkey")
  @@index([clinicId])
  @@index([userId])
  @@map("stock_movements")
}

model Treatment {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   Consultation @relation(fields: [consultationId], references: [id], map: "Treatment_consultationId_fkey")

  @@index([consultationId], map: "Treatment_consultationId_fkey")
  @@map("treatments")
}

enum ProductPriceType {
  FIXED
  VARIABLE
}

enum FiscalDocumentType {
  E_TICKET
  E_FACTURA
  E_TICKET_NOTA_CREDITO
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  MERCADO_PAGO
  ACCOUNT_CREDIT
}

enum MedicalPlanPeriodicity {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum MedicalPlanStatus {
  ACTIVE
  INACTIVE
}

enum ClientSubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum SubscriptionInstallmentStatus {
  PENDING
  PAID
  CANCELLED
}

enum LateFeeType {
  NONE
  FIXED
  PERCENTAGE
}

enum FiscalDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConsultationStatus {
  OPEN
  CLOSED
  CANCELED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

enum PriorityConsultation {
  URGENT
  SCHEDULED
  NORMAL
}

enum CashShiftStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  ADJUSTMENT
}

model CashRegister {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?
  clinicId  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  shifts          CashShift[]
  ticketPrints    TicketPrint[]
  cashAuditEvents CashAuditEvent[]

  @@unique([clinicId, name])
  @@unique([clinicId, code])
  @@index([clinicId])
  @@map("cash_registers")
}

model CashShift {
  id             Int @id @default(autoincrement())
  cashRegisterId Int
  userId         Int
  clinicId       Int

  status CashShiftStatus @default(OPEN)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingAmount  Decimal  @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  countedAmount  Decimal? @db.Decimal(12, 2)
  difference     Decimal? @db.Decimal(12, 2)

  closingNotes     String?
  differenceReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  clinic       Clinic       @relation(fields: [clinicId], references: [id])

  movements       CashMovement[]
  payments        Payment[]
  sales           Sale[]
  ticketPrints    TicketPrint[]
  cashAuditEvents CashAuditEvent[]

  @@index([cashRegisterId])
  @@index([userId])
  @@index([clinicId])
  @@index([status])
  @@map("cash_shifts")
}

model CashMovement {
  id Int @id @default(autoincrement())

  cashShiftId Int
  clinicId    Int
  userId      Int

  type CashMovementType

  amount Decimal @db.Decimal(12, 2)

  reason String?
  notes  String?

  createdAt DateTime @default(now())

  cashShift CashShift @relation(fields: [cashShiftId], references: [id])
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([cashShiftId])
  @@index([clinicId])
  @@index([userId])
  @@index([type])
  @@map("cash_movements")
}

model TicketPrint {
  id             Int             @id @default(autoincrement())
  saleId         Int
  userId         Int
  clinicId       Int
  cashShiftId    Int?
  cashRegisterId Int?
  type           TicketPrintType
  reprintNumber  Int             @default(0)
  reason         String?
  createdAt      DateTime        @default(now())

  sale         Sale          @relation(fields: [saleId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  cashShift    CashShift?    @relation(fields: [cashShiftId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])

  @@index([saleId])
  @@index([clinicId])
  @@index([userId])
  @@index([cashShiftId])
  @@index([cashRegisterId])
  @@map("ticket_prints")
}

enum TicketPrintType {
  ORIGINAL
  DUPLICATE
}

model CashAuditEvent {
  id             Int      @id @default(autoincrement())
  action         String
  clinicId       Int
  userId         Int
  cashRegisterId Int?
  cashShiftId    Int?
  saleId         Int?
  details        Json?
  createdAt      DateTime @default(now())

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  cashShift    CashShift?    @relation(fields: [cashShiftId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id])

  @@index([clinicId])
  @@index([userId])
  @@index([cashRegisterId])
  @@index([cashShiftId])
  @@index([saleId])
  @@index([action])
  @@map("cash_audit_events")
}

model Consultorio {
  id       Int @id @default(autoincrement())
  clinicId Int

  name        String
  description String? @db.Text
  size        String?

  status ConsultorioStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  equipment     ConsultorioEquipment[]
  consultations Consultation[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([clinicId, status])
  @@map("consultorios")
}

model Equipment {
  id       Int @id @default(autoincrement())
  clinicId Int

  name        String
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  consultorios ConsultorioEquipment[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("equipment")
}

model ConsultorioEquipment {
  id Int @id @default(autoincrement())

  consultorioId Int
  equipmentId   Int

  quantity Int             @default(1)
  status   EquipmentStatus @default(AVAILABLE)
  notes    String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultorio Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([consultorioId, equipmentId])
  @@index([consultorioId])
  @@index([equipmentId])
  @@map("consultorio_equipment")
}

enum ConsultorioStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EquipmentStatus {
  AVAILABLE
  MAINTENANCE
  OUT_OF_SERVICE
}
