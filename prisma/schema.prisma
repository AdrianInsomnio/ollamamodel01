generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id             Int            @id @default(autoincrement())
  name           String
  rut            String?        @unique
  website        String?
  imageUrl       String?
  imagePublicId  String?
  imageVersion   String?
  address        String?
  phone          String?
  email          String?
  isDefault      Boolean        @default(false)
  organizationId Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  isActive       Boolean        @default(true)
  timezone       String?        @default("America/Montevideo")
  appointments   Appointment[]
  attachments    Attachment[]
  clients        Client[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  consultations  Consultation[]
  medicalPlans   MedicalPlan[]
  products       Product[]
  refreshTokens  RefreshToken[]
  sales          Sale[]
  services       Service[]
  users          User[]         @relation("UserClinics")

  @@index([organizationId], map: "clinics_organizationId_fkey")
  @@map("clinics")
}

model User {
  id                Int            @id @default(autoincrement())
  username          String         @unique @db.VarChar(50)
  email             String         @unique @db.VarChar(100)
  password          String         @db.VarChar(255)
  role              String         @default("USER")
  isActive          Boolean        @default(true)
  lastLogin         DateTime?
  passwordChangedAt DateTime?      @db.DateTime(0)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  organizationId    Int
  refreshTokens     RefreshToken[]
  organization      Organization   @relation(fields: [organizationId], references: [id])
  subscriptions     Subscription[] @relation("SubscriptionUsers")
  clinics           Clinic[]       @relation("UserClinics")

  @@index([organizationId], map: "users_organizationId_fkey")
  @@map("users")
}

model RefreshToken {
  id             Int          @id @default(autoincrement())
  token          String       @db.Text
  userId         Int          @map("user_id")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  role           String
  clinicId       Int?         @map("clinic_id")
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId], map: "refresh_tokens_clinic_id_fkey")
  @@index([userId], map: "refresh_tokens_user_id_fkey")
  @@index([organizationId], map: "refresh_tokens_organizationId_fkey")
  @@map("refresh_tokens")
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  sku            String?          @unique
  categoryId     Int?             @map("category_id")
  price          Float
  cost           Float?
  stock          Int              @default(0)
  minStock       Int              @default(5)
  isActive       Boolean          @default(true)
  discontinuedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  clinicId       Int
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  clinic         Clinic           @relation(fields: [clinicId], references: [id])
  stockMovements StockMovement[]

  @@index([categoryId], map: "products_category_id_fkey")
  @@index([clinicId], map: "products_clinicId_fkey")
  @@map("products")
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinicId    Int       @default(1)
  products    Product[]

  @@map("product_categories")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  duration    Int?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinicId    Int
  clinic      Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId], map: "services_clinicId_fkey")
  @@map("services")
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  interval      String
  features      Json
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id             Int          @id @default(autoincrement())
  planId         Int
  organizationId Int
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean      @default(true)
  paymentMethod  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  plan           Plan         @relation(fields: [planId], references: [id])
  users          User[]       @relation("SubscriptionUsers")

  @@index([organizationId], map: "subscriptions_organizationId_fkey")
  @@index([planId], map: "subscriptions_planId_fkey")
  @@map("subscriptions")
}

model Appointment {
  id           Int           @id @default(autoincrement())
  date         DateTime
  duration     Int           @default(30)
  status       String        @default("pending")
  serviceType  String?
  notes        String?
  clientId     Int
  petId        Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  clinicId     Int
  client       Client        @relation(fields: [clientId], references: [id], map: "Appointment_clientId_fkey")
  clinic       Clinic        @relation(fields: [clinicId], references: [id], map: "Appointment_clinicId_fkey")
  pet          Pet           @relation(fields: [petId], references: [id], map: "Appointment_petId_fkey")
  consultation Consultation?

  @@index([clientId], map: "Appointment_clientId_fkey")
  @@index([clinicId], map: "Appointment_clinicId_fkey")
  @@index([petId], map: "Appointment_petId_fkey")
  @@map("appointments")
}

model Attachment {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  fileUrl    String
  createdAt  DateTime @default(now())
  clinicId   Int
  clinic     Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId], map: "attachment_clinicId_fkey")
  @@map("attachments")
}

model Client {
  id                  Int                  @id @default(autoincrement())
  name                String
  documentId          String?              @unique(map: "Client_documentId_key")
  phone               String?
  phone2              String?
  email               String?
  address             String?
  birthDate           DateTime?
  notes               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())
  clinicId            Int
  appointments        Appointment[]
  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  clientSubscriptions ClientSubscription[]
  consultations       Consultation[]
  fiscalDocuments     FiscalDocument[]
  pets                Pet[]
  sales               Sale[]

  @@index([clinicId], map: "Client_clinicId_fkey")
  @@map("clients")
}

model ClientSubscription {
  id            Int         @id @default(autoincrement())
  medicalPlanId Int
  clientId      Int
  petId         Int?
  startDate     DateTime    @default(now())
  endDate       DateTime?
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now())
  client        Client      @relation(fields: [clientId], references: [id])
  medicalPlan   MedicalPlan @relation(fields: [medicalPlanId], references: [id])
  pet           Pet?        @relation(fields: [petId], references: [id])

  @@index([clientId])
  @@index([medicalPlanId])
  @@index([petId])
  @@map("client_subscriptions")
}

model Consultation {
  id              Int              @id @default(autoincrement())
  petId           Int
  clientId        Int
  appointmentId   Int?             @unique(map: "Consultation_appointmentId_key")
  weight          Float?
  temperature     Float?
  symptoms        String?
  notes           String?
  consultationFee Float            @default(0)
  treatmentFee    Float            @default(0)
  totalFee        Float            @default(0)
  status          String           @default("OPEN")
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
  clinicId        Int
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id], map: "Consultation_appointmentId_fkey")
  client          Client           @relation(fields: [clientId], references: [id], map: "Consultation_clientId_fkey")
  clinic          Clinic           @relation(fields: [clinicId], references: [id], map: "Consultation_clinicId_fkey")
  pet             Pet              @relation(fields: [petId], references: [id], map: "Consultation_petId_fkey")
  diagnoses       Diagnosis[]
  fiscalDocuments FiscalDocument[]
  prescriptions   Prescription[]
  sales           Sale[]
  treatments      Treatment[]

  @@index([clientId], map: "Consultation_clientId_fkey")
  @@index([clinicId], map: "Consultation_clinicId_fkey")
  @@index([petId], map: "Consultation_petId_fkey")
  @@map("consultations")
}

model Diagnosis {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   Consultation @relation(fields: [consultationId], references: [id], map: "Diagnosis_consultationId_fkey")

  @@index([consultationId], map: "Diagnosis_consultationId_fkey")
  @@map("diagnoses")
}

model FiscalDocument {
  id             String               @id
  type           FiscalDocumentType
  series         String?
  number         Int?
  issuedAt       DateTime             @default(now())
  clientId       Int
  consultationId Int?
  subtotal       Decimal
  tax            Decimal
  total          Decimal
  currency       String               @default("UYU")
  cae            String?
  caeExpiration  DateTime?
  cfeXml         String?
  cfePdfUrl      String?
  status         FiscalDocumentStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  client         Client               @relation(fields: [clientId], references: [id], map: "FiscalDocument_clientId_fkey")
  consultation   Consultation?        @relation(fields: [consultationId], references: [id], map: "FiscalDocument_consultationId_fkey")
  fiscalItems    FiscalItem[]
  payments       Payment[]

  @@index([clientId], map: "FiscalDocument_clientId_fkey")
  @@index([consultationId], map: "FiscalDocument_consultationId_fkey")
  @@map("fiscal_documents")
}

model FiscalItem {
  id               String         @id
  fiscalDocumentId String
  description      String
  quantity         Decimal
  unitPrice        Decimal
  taxRate          Decimal
  total            Decimal
  fiscalDocument   FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], map: "FiscalItem_fiscalDocumentId_fkey")

  @@index([fiscalDocumentId], map: "FiscalItem_fiscalDocumentId_fkey")
  @@map("fiscal_items")
}

model IdempotencyKey {
  id         Int      @id @default(autoincrement())
  key        String
  endpoint   String
  response   Json?
  statusCode Int?
  createdAt  DateTime @default(now())

  @@unique([key, endpoint], map: "IdempotencyKey_key_endpoint_key")
  @@map("idempotency_keys")
}

model MedicalPlan {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?
  price               Float
  benefits            Json
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())
  clinicId            Int
  clientSubscriptions ClientSubscription[]
  clinic              Clinic               @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@map("medical_plans")
}

model Organization {
  id            Int            @id @default(autoincrement())
  name          String
  address       String?
  phone         String?
  email         String?
  taxId         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  timezone      String?        @default("UTC")
  clinics       Clinic[]
  subscriptions Subscription[]
  users         User[]
  refreshTokens RefreshToken[]

  @@map("organizations")
}

model Payment {
  id               String         @id
  fiscalDocumentId String
  amount           Decimal
  method           PaymentMethod
  reference        String?
  notes            String?
  paidAt           DateTime       @default(now())
  createdAt        DateTime       @default(now())
  fiscalDocument   FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], map: "Payment_fiscalDocumentId_fkey")

  @@index([fiscalDocumentId], map: "Payment_fiscalDocumentId_fkey")
  @@map("payments")
}

model Pet {
  id                  Int                  @id @default(autoincrement())
  name                String
  species             String
  breed               String?
  birthDate           DateTime?
  weight              Float?
  color               String?
  microchip           String?              @unique(map: "Pet_microchip_key")
  isActive            Boolean              @default(true)
  notes               String?
  clientId            Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())
  birthDateEstimated  Boolean?             @default(false)
  deathDate           DateTime?
  appointments        Appointment[]
  clientSubscriptions ClientSubscription[]
  consultations       Consultation[]
  client              Client               @relation(fields: [clientId], references: [id], map: "Pet_clientId_fkey")
  sales               Sale[]

  @@index([clientId], map: "Pet_clientId_fkey")
  @@map("pets")
}

model Prescription {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   Consultation @relation(fields: [consultationId], references: [id], map: "Prescription_consultationId_fkey")

  @@index([consultationId], map: "Prescription_consultationId_fkey")
  @@map("prescriptions")
}

model Sale {
  id             Int           @id @default(autoincrement())
  clientId       Int
  petId          Int?
  consultationId Int?
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  tax            Float         @default(0)
  total          Float         @default(0)
  status         String        @default("completed")
  paymentMethod  String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  clinicId       Int
  client         Client        @relation(fields: [clientId], references: [id], map: "Sale_clientId_fkey")
  consultation   Consultation? @relation(fields: [consultationId], references: [id], map: "Sale_consultationId_fkey")
  pet            Pet?          @relation(fields: [petId], references: [id], map: "Sale_petId_fkey")
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  saleItems      SaleItem[]

  @@index([clientId], map: "Sale_clientId_fkey")
  @@index([clinicId], map: "Sale_clinicId_fkey")
  @@index([consultationId], map: "Sale_consultationId_fkey")
  @@index([petId], map: "Sale_petId_fkey")
  @@map("sales")
}

model SaleItem {
  id            Int    @id @default(autoincrement())
  saleId        Int
  itemType      String
  itemId        Int
  nameSnapshot  String
  priceSnapshot Float
  quantity      Int
  subtotal      Float
  sale          Sale   @relation(fields: [saleId], references: [id], map: "SaleItem_saleId_fkey")

  @@index([saleId], map: "SaleItem_saleId_fkey")
  @@map("sale_items")
}

model StockMovement {
  id            Int      @id @default(autoincrement())
  productId     Int
  type          String
  quantity      Int
  reason        String?
  referenceType String?
  referenceId   Int?
  notes         String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], map: "StockMovement_productId_fkey")

  @@index([productId], map: "StockMovement_productId_fkey")
  @@map("stock_movements")
}

model Treatment {
  id             Int          @id @default(autoincrement())
  consultationId Int
  description    String
  consultation   Consultation @relation(fields: [consultationId], references: [id], map: "Treatment_consultationId_fkey")

  @@index([consultationId], map: "Treatment_consultationId_fkey")
  @@map("treatments")
}

enum FiscalDocumentType {
  E_TICKET
  E_FACTURA
  E_TICKET_NOTA_CREDITO
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  MERCADO_PAGO
  ACCOUNT_CREDIT
}

enum FiscalDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}
